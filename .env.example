# Copy to .env.local and fill in. Never commit .env.local.

# Hevy: Settings → Developer at https://hevy.com/settings?developer (needs Hevy Pro)
HEVY_API_KEY=
# 1 = use realistic sample data instead of the Hevy API (handy before you have a key)
HEVY_MOCK=1

# Postgres connection string. Leave empty to use the embedded local database in ./.data.
# On Vercel, connecting a Neon database sets this. Supabase: the "Transaction pooler" string (port 6543)
DATABASE_URL=

# Optional: lets scripts call /api/sync with an x-sync-secret header (the dashboard uses your sign-in)
SYNC_SECRET=
# Set in Vercel; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- Sign-in (Auth.js). Setup steps are in the README. ---
# Session encryption key: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Comma-separated emails allowed to sign in (empty: anyone locally, nobody in production)
ALLOWED_EMAILS=

# Email codes via Resend (https://resend.com). Empty: locally the code prints in the terminal.
AUTH_RESEND_KEY=
# Optional sender once your domain is verified in Resend, e.g. Master Dashboard <login@yourdomain.com>
AUTH_EMAIL_FROM=

# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sign in with Apple is hidden until this is "true" (needs a paid Apple Developer account)
ENABLE_APPLE_SIGNIN=
# Apple Developer: the Services ID, and the secret printed by `npm run apple-secret -- AuthKey_XXXX.p8`
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
